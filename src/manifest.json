{
  "manifest_version": 3,
  "name": "Read Aloud – Natural Voice",
  "version": "1.0.1",
  "description": "Select text, right-click, and hear it in a natural open-source voice (Kokoro). Runs privately on your computer.",
  "permissions": [
    "contextMenus",
    "offscreen",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Read the selected text aloud"
    },
    "stop": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Stop reading"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "homepage_url": "https://github.com/shimshihub/read-aloud"
}
